# Preserve recovered artifact bytes so provenance hashes survive Git checkouts.
*.xmi -text -whitespace
*.ecore -text -whitespace
*.sql -text -whitespace
*.txt -text -whitespace
*.docx binary
*.md text eol=lf
*.json text eol=lf
*.sha256 text eol=lf

# Preserve unchanged upstream project snapshots, including original line endings.
software/source-projects/** -text -whitespace

# Preserve hashes of extracted query candidates across checkouts.
cases/**/queries/*.js -text -whitespace
