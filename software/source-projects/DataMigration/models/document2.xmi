<?xml version="1.0" encoding="ASCII"?>
<documentschema:DocumentSchema xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:documentschema="http://www.example.org/documentschema" name="MetaShop">
  <entities name="AppUser">
    <properties xsi:type="documentschema:Attribute" name="name" type="//@types.0"/>
    <properties xsi:type="documentschema:Attribute" name="email" type="//@types.0"/>
    <properties xsi:type="documentschema:Attribute" name="password" type="//@types.0"/>
    <properties xsi:type="documentschema:Attribute" name="address" type="//@types.0"/>
    <properties xsi:type="documentschema:Attribute" name="country" type="//@types.0"/>
    <properties xsi:type="documentschema:Attribute" name="registrationDate" type="//@types.0"/>
    <properties xsi:type="documentschema:Attribute" name="storeValuation" type="//@types.1"/>
    <properties xsi:type="documentschema:Attribute" name="premium" type="//@types.1"/>
    <properties xsi:type="documentschema:Attribute" name="date_premium" type="//@types.0"/>
    <properties xsi:type="documentschema:Attribute" name="premium_fee" type="//@types.1"/>
    <properties xsi:type="documentschema:Attribute" name="card_number" type="//@types.0"/>
    <properties xsi:type="documentschema:Attribute" name="AppUser_id" isKey="true" type="//@types.1"/>
    <properties xsi:type="documentschema:Aggregate" name="PaymentMethods" isMany="true">
      <aggregates xsi:type="documentschema:Attribute" name="methodName" type="//@types.0"/>
      <aggregates xsi:type="documentschema:Attribute" name="methodInfo" type="//@types.0"/>
      <aggregates xsi:type="documentschema:Attribute" name="id_id" isKey="true" type="//@types.1"/>
      <aggregates xsi:type="documentschema:Attribute" name="PaymentMethods_id" isKey="true" type="//@types.1"/>
    </properties>
    <properties xsi:type="documentschema:Reference" name="appUsers" target="//@entities.0" type="//@types.5"/>
    <properties xsi:type="documentschema:Reference" name="userOrders" target="//@entities.3" type="//@types.4"/>
  </entities>
  <entities name="Product">
    <properties xsi:type="documentschema:Attribute" name="name" type="//@types.0"/>
    <properties xsi:type="documentschema:Attribute" name="price" type="//@types.1"/>
    <properties xsi:type="documentschema:Attribute" name="description" type="//@types.0"/>
    <properties xsi:type="documentschema:Attribute" name="imageURL" type="//@types.0"/>
    <properties xsi:type="documentschema:Attribute" name="manufacturer" type="//@types.0"/>
    <properties xsi:type="documentschema:Attribute" name="stock" type="//@types.1"/>
    <properties xsi:type="documentschema:Attribute" name="Product_id" isKey="true" type="//@types.1"/>
    <properties xsi:type="documentschema:Reference" name="items" target="//@entities.4" type="//@types.4"/>
  </entities>
  <entities name="Category">
    <properties xsi:type="documentschema:Attribute" name="description" type="//@types.0"/>
    <properties xsi:type="documentschema:Attribute" name="Category_id" isKey="true" type="//@types.1"/>
    <properties xsi:type="documentschema:Reference" name="products" target="//@entities.1" type="//@types.5"/>
  </entities>
  <entities name="UserOrder">
    <properties xsi:type="documentschema:Attribute" name="orderDate" type="//@types.0"/>
    <properties xsi:type="documentschema:Attribute" name="totalPrice" type="//@types.1"/>
    <properties xsi:type="documentschema:Attribute" name="UserOrder_id" isKey="true" type="//@types.0"/>
    <properties xsi:type="documentschema:Reference" name="items" target="//@entities.4" type="//@types.4"/>
    <properties xsi:type="documentschema:Reference" name="discounts" target="//@entities.5" type="//@types.5"/>
  </entities>
  <entities name="Item">
    <properties xsi:type="documentschema:Attribute" name="amount" type="//@types.1"/>
    <properties xsi:type="documentschema:Attribute" name="subtotal" type="//@types.1"/>
    <properties xsi:type="documentschema:Attribute" name="Item_id" isKey="true" type="//@types.0"/>
  </entities>
  <entities name="Discount">
    <properties xsi:type="documentschema:Attribute" name="description" type="//@types.0"/>
    <properties xsi:type="documentschema:Attribute" name="discountRatio" type="//@types.1"/>
    <properties xsi:type="documentschema:Attribute" name="Discount_id" isKey="true" type="//@types.1"/>
  </entities>
  <entities name="RelatedProducts">
    <properties xsi:type="documentschema:Attribute" name="affinity" type="//@types.1"/>
    <properties xsi:type="documentschema:Attribute" name="RelatedProducts_id" isKey="true" type="//@types.1"/>
    <properties xsi:type="documentschema:Reference" name="product_id_fk" target="//@entities.1"/>
    <properties xsi:type="documentschema:Reference" name="product_related_id_fk" target="//@entities.1"/>
  </entities>
  <types xsi:type="documentschema:PrimitiveType" datatype="STRING"/>
  <types xsi:type="documentschema:PrimitiveType" datatype="INTEGER"/>
  <types xsi:type="documentschema:PrimitiveType" datatype="DOUBLE"/>
  <types xsi:type="documentschema:PrimitiveType"/>
  <types xsi:type="documentschema:Array" type="//@types.0"/>
  <types xsi:type="documentschema:Array" type="//@types.1"/>
  <types xsi:type="documentschema:Array" type="//@types.2"/>
  <types xsi:type="documentschema:Array" type="//@types.3"/>
</documentschema:DocumentSchema>
