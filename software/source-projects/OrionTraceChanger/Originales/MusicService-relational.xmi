<?xml version="1.0" encoding="UTF-8"?>
<relationalschema:RelationalSchema
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:relationalschema="http://www.example.org/relationalschema"
    name="MusicService"
    version="1"
    location="modelum.um.es">
  <tables name="app_user">
    <columns
        name="user_id"
        datatype="CHAR"
        size="36"/>
    <columns
        name="name"
        datatype="VARCHAR"
        size="80"/>
    <columns
        name="is_premium"
        datatype="NUMBER"
        defaultvalue="0"/>
    <columns
        name="register_date"
        datatype="DATE"/>
    <keys columns="//@tables.0/@columns.0"
        constraintname="user_pk"/>
    <keys columns="//@tables.0/@columns.1"
        constraintname="user_name_ak"
        isPK="false"/>
  </tables>
  <tables name="song">
    <columns
        name="song_id"
        datatype="CHAR"
        size="36"/>
    <columns
        name="title"
        datatype="VARCHAR"
        size="100"/>
    <columns
        name="duration"
        datatype="DECIMAL"
        size="4"/>
    <columns
        name="artist"
        datatype="VARCHAR"
        size="120"/>
    <columns
        name="plays_count"
        datatype="INTEGER"
        size="3"
        defaultvalue="0"/>
    <keys columns="//@tables.1/@columns.0"
        constraintname="song_pk"/>
  </tables>
  <tables name="musical_style">
    <columns
        name="style_id"
        datatype="CHAR"
        size="36"/>
    <columns
        name="name"
        datatype="VARCHAR"
        size="100"/>
    <keys columns="//@tables.2/@columns.0"
        constraintname="style_pk"/>
  </tables>
  <tables name="song_style">
    <columns
        name="song_id"
        datatype="CHAR"
        size="36"/>
    <columns
        name="style_id"
        datatype="CHAR"
        size="36"/>
    <keys columns="//@tables.3/@columns.0 //@tables.3/@columns.1"/>
    <fks columns="//@tables.3/@columns.0"
        refsTo="//@tables.1/@keys.0"
        onDelete="CASCADE"
        constraintname="song_style_fk_song"/>
    <fks columns="//@tables.3/@columns.1"
        refsTo="//@tables.2/@keys.0"
        onDelete="CASCADE"
        constraintname="song_style_fk_style"/>
  </tables>
  <tables name="playlist">
    <columns
        name="playlist_id"
        datatype="CHAR"
        size="36"/>
    <columns
        name="user_id"
        datatype="CHAR"
        size="36"/>
    <columns
        name="name"
        datatype="VARCHAR"
        size="30"
        nullable="true"/>
    <columns
        name="creation_date"
        datatype="DATE"/>
    <keys columns="//@tables.4/@columns.0 //@tables.4/@columns.1"
        constraintname="playlist_pk"/>
    <fks columns="//@tables.4/@columns.1"
        refsTo="//@tables.0/@keys.0"
        onDelete="CASCADE"
        constraintname="playlist_fk_user"/>
  </tables>
  <tables name="playlist_song">
    <columns
        name="playlist_id"
        datatype="CHAR"
        size="36"/>
    <columns
        name="user_id"
        datatype="CHAR"
        size="36"/>
    <columns
        name="position_idx"
        datatype="INTEGER"
        size="3"/>
    <columns
        name="song_id"
        datatype="CHAR"
        size="36"/>
    <keys columns="//@tables.5/@columns.0 //@tables.5/@columns.1 //@tables.5/@columns.2"
        constraintname="playlist_song_pk"/>
    <fks columns="//@tables.5/@columns.0 //@tables.5/@columns.1"
        refsTo="//@tables.4/@keys.0"
        constraintname="playlist_song_fk_playlist"/>
    <fks columns="//@tables.5/@columns.3"
        refsTo="//@tables.1/@keys.0"
        constraintname="playlist_song_fk_song"/>
  </tables>
  <tables name="listening">
    <columns
        name="user_id"
        datatype="CHAR"
        size="36"/>
    <columns
        name="song_id"
        datatype="CHAR"
        size="36"/>
    <columns
        name="plays_count"
        datatype="INTEGER"
        size="3"/>
    <columns
        name="status"
        datatype="VARCHAR"
        size="10"/>
    <keys columns="//@tables.6/@columns.0 //@tables.6/@columns.1"
        constraintname="listening_pk"/>
    <fks columns="//@tables.6/@columns.0"
        refsTo="//@tables.0/@keys.0"
        onDelete="CASCADE"
        constraintname="listening_fk_user"/>
    <fks columns="//@tables.6/@columns.1"
        refsTo="//@tables.1/@keys.0"
        onDelete="CASCADE"
        constraintname="listening_fk_song"/>
  </tables>
  <tables name="most_recent_song">
    <columns
        name="user_id"
        datatype="CHAR"
        size="36"/>
    <columns
        name="position_idx"
        datatype="INTEGER"
        size="3"/>
    <columns
        name="song_id"
        datatype="CHAR"
        size="36"/>
    <keys columns="//@tables.7/@columns.0 //@tables.7/@columns.1"
        constraintname="most_recent_song_pk"/>
    <fks columns="//@tables.7/@columns.0"
        refsTo="//@tables.0/@keys.0"
        onDelete="CASCADE"
        constraintname="most_recent_song_fk_user"/>
    <fks columns="//@tables.7/@columns.2"
        refsTo="//@tables.1/@keys.0"
        constraintname="most_recent_song_fk_song"/>
  </tables>
</relationalschema:RelationalSchema>
