<?xml version="1.0" encoding="ASCII"?>
<uschema:USchema xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:uschema="http://www.modelum.es/uschema" name="MusicService">
  <entities name="app_user" root="true">
    <features xsi:type="uschema:Attribute" name="user_id" key="//@entities.0/@features.4">
      <type xsi:type="uschema:PrimitiveType" name="string"/>
    </features>
    <features xsi:type="uschema:Attribute" name="name" key="//@entities.0/@features.5">
      <type xsi:type="uschema:PrimitiveType" name="string"/>
    </features>
    <features xsi:type="uschema:Attribute" name="is_premium">
      <type xsi:type="uschema:PrimitiveType" name="double"/>
    </features>
    <features xsi:type="uschema:Attribute" name="register_date">
      <type xsi:type="uschema:PrimitiveType" name="date"/>
    </features>
    <features xsi:type="uschema:Key" name="user_pk" attributes="//@entities.0/@features.0"/>
    <features xsi:type="uschema:Key" name="user_name_ak" attributes="//@entities.0/@features.1" isID="false"/>
    <features xsi:type="uschema:Aggregate" name="playlist" specifiedBy="//@entities.3" upperBound="-1"/>
    <features xsi:type="uschema:Reference" name="listening_fk_song" refsTo="//@entities.1" upperBound="-1" isFeaturedBy="//@relationships.1"/>
    <features xsi:type="uschema:Aggregate" name="most_recent_song" specifiedBy="//@entities.5" upperBound="-1"/>
  </entities>
  <entities name="song" root="true">
    <features xsi:type="uschema:Attribute" name="song_id" key="//@entities.1/@features.5">
      <type xsi:type="uschema:PrimitiveType" name="string"/>
    </features>
    <features xsi:type="uschema:Attribute" name="title">
      <type xsi:type="uschema:PrimitiveType" name="string"/>
    </features>
    <features xsi:type="uschema:Attribute" name="duration">
      <type xsi:type="uschema:PrimitiveType" name="double"/>
    </features>
    <features xsi:type="uschema:Attribute" name="artist">
      <type xsi:type="uschema:PrimitiveType" name="string"/>
    </features>
    <features xsi:type="uschema:Attribute" name="plays_count">
      <type xsi:type="uschema:PrimitiveType" name="int"/>
    </features>
    <features xsi:type="uschema:Key" name="song_pk" attributes="//@entities.1/@features.0"/>
    <features xsi:type="uschema:Reference" name="song_style_fk_style" refsTo="//@entities.2" upperBound="-1" isFeaturedBy="//@relationships.0"/>
    <features xsi:type="uschema:Reference" name="listening_fk_user" refsTo="//@entities.0" upperBound="-1" isFeaturedBy="//@relationships.1"/>
  </entities>
  <entities name="musical_style" root="true">
    <features xsi:type="uschema:Attribute" name="style_id" key="//@entities.2/@features.2">
      <type xsi:type="uschema:PrimitiveType" name="string"/>
    </features>
    <features xsi:type="uschema:Attribute" name="name">
      <type xsi:type="uschema:PrimitiveType" name="string"/>
    </features>
    <features xsi:type="uschema:Key" name="style_pk" attributes="//@entities.2/@features.0"/>
    <features xsi:type="uschema:Reference" name="song_style_fk_song" refsTo="//@entities.1" upperBound="-1" isFeaturedBy="//@relationships.0"/>
  </entities>
  <entities name="playlist" aggregate="//@entities.0/@features.6">
    <features xsi:type="uschema:Attribute" name="playlist_id" key="//@entities.3/@features.3">
      <type xsi:type="uschema:PrimitiveType" name="string"/>
    </features>
    <features xsi:type="uschema:Attribute" name="name" optional="true">
      <type xsi:type="uschema:PrimitiveType" name="string"/>
    </features>
    <features xsi:type="uschema:Attribute" name="creation_date">
      <type xsi:type="uschema:PrimitiveType" name="date"/>
    </features>
    <features xsi:type="uschema:Key" name="playlist_pk" attributes="//@entities.3/@features.0"/>
    <features xsi:type="uschema:Aggregate" name="playlist_song" specifiedBy="//@entities.4" upperBound="-1"/>
  </entities>
  <entities name="playlist_song" aggregate="//@entities.3/@features.4">
    <features xsi:type="uschema:Attribute" name="position_idx" key="//@entities.4/@features.1">
      <type xsi:type="uschema:PrimitiveType" name="int"/>
    </features>
    <features xsi:type="uschema:Key" name="playlist_song_pk" attributes="//@entities.4/@features.0"/>
    <features xsi:type="uschema:Reference" name="playlist_song_fk_song" refsTo="//@entities.1" attributes="//@entities.4/@features.3" upperBound="1"/>
    <features xsi:type="uschema:Attribute" name="song_id" references="//@entities.4/@features.2">
      <type xsi:type="uschema:PrimitiveType" name="string"/>
    </features>
  </entities>
  <entities name="most_recent_song" aggregate="//@entities.0/@features.8">
    <features xsi:type="uschema:Attribute" name="position_idx" key="//@entities.5/@features.1">
      <type xsi:type="uschema:PrimitiveType" name="int"/>
    </features>
    <features xsi:type="uschema:Key" name="most_recent_song_pk" attributes="//@entities.5/@features.0"/>
    <features xsi:type="uschema:Reference" name="most_recent_song_fk_song" refsTo="//@entities.1" attributes="//@entities.5/@features.3" upperBound="1"/>
    <features xsi:type="uschema:Attribute" name="song_id" references="//@entities.5/@features.2">
      <type xsi:type="uschema:PrimitiveType" name="string"/>
    </features>
  </entities>
  <relationships name="song_style" references="//@entities.2/@features.3 //@entities.1/@features.6"/>
  <relationships name="listening" references="//@entities.1/@features.7 //@entities.0/@features.7">
    <features xsi:type="uschema:Attribute" name="plays_count">
      <type xsi:type="uschema:PrimitiveType" name="int"/>
    </features>
    <features xsi:type="uschema:Attribute" name="status">
      <type xsi:type="uschema:PrimitiveType" name="string"/>
    </features>
  </relationships>
</uschema:USchema>
